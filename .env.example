# Copy to .env and fill in. Never commit .env.
# Comments must be on their own line: systemd's EnvironmentFile
# does not understand comments after a value.

# Who serves the model: openrouter or openai. Only that provider's key is needed.
LLM_PROVIDER=openrouter
# OpenRouter (openrouter.ai -> Keys). The free model is rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OpenAI (platform.openai.com -> API keys).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional: a different model for one role (it must have a price in app/config.py).
# AGENT_MODEL=
# CUSTOMER_SIM_MODEL=

# Spend caps in USD
SESSION_COST_CAP_USD=0.05
DAILY_COST_CAP_USD=2.00

# How much reasoning models think before answering: minimal, low, medium, high
REASONING_EFFORT=low

# Where the submission agent finds the carrier portals. They live in this same
# app, so this is the app's own address; change it only if you change the port.
PORTAL_BASE_URL=http://127.0.0.1:8000

# The site's public address, used in link previews (Open Graph). Optional; this is the default.
# SITE_URL=https://quoterunner.ramiyer.tech
