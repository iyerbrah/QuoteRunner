# Copy to .env and fill in. Never commit .env.
# Comments must be on their own line: systemd's EnvironmentFile
# does not understand comments after a value.

# openai or openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model per role (each must have a price in app/config.py)
AGENT_MODEL=gpt-5-nano
CUSTOMER_SIM_MODEL=gpt-5-nano

# Spend caps in USD
SESSION_COST_CAP_USD=0.05
DAILY_COST_CAP_USD=2.00

# How much reasoning models think before answering: minimal, low, medium, high
REASONING_EFFORT=low

# Where the submission agent finds the carrier portals. They live in this same
# app, so this is the app's own address; change it only if you change the port.
PORTAL_BASE_URL=http://127.0.0.1:8000
